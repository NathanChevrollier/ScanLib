# ---------------------------------------------------------------------------
# ScanLib — configuration
# Copier en `.env` et compléter. Ne jamais committer le `.env`.
# ---------------------------------------------------------------------------

# --- Base de données -------------------------------------------------------
POSTGRES_USER=scanlib
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=scanlib
# En local (hors Docker) : localhost. Dans Docker Compose : postgres
DATABASE_URL=postgresql://scanlib:change-me-please@localhost:5432/scanlib

# --- API -------------------------------------------------------------------
API_PORT=3001
NODE_ENV=development
# Origine autorisée pour le navigateur (front). Plusieurs valeurs séparées par des virgules.
CORS_ORIGIN=http://localhost:5173

# Secret de signature des JWT — générer avec : openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-string
# Durées de vie
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Cookies en Secure (obligatoire en production HTTPS)
COOKIE_SECURE=false
# Domaine du cookie en production (ex: scanlib.mondomaine.fr) — vide en local
COOKIE_DOMAIN=

# Inscription ouverte ? false = comptes créés par invitation ou CLI uniquement.
ALLOW_OPEN_REGISTRATION=false

# --- Fournisseurs de données ----------------------------------------------
# TMDB : clé v3 gratuite sur https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Région et langues par défaut pour les liens officiels
DEFAULT_WATCH_REGIONS=FR,US
DEFAULT_LANGUAGES=fr,en

# AniList : meilleure source gratuite pour les liens de streaming typés et la
# grille de diffusion. Activée par défaut. Son API est parfois coupée par ses
# mainteneurs : le coupe-circuit l'écarte alors tout seul, les autres sources
# prennent le relais et l'état est visible dans Réglages › État des sources.
ENABLE_ANILIST=true

# Autres sources publiques utilisées, sans clé ni configuration :
#   MangaDex  — chapitres et dates de publication des scans
#   Jikan     — MyAnimeList, animés et mangas
#   Kitsu     — titres et résumés localisés (souvent les seuls en français)
#   TVmaze    — séries TV et grille de diffusion épisode par épisode

# User-Agent envoyé aux API publiques (courtoisie / exigé par MangaDex)
PROVIDER_USER_AGENT=ScanLib/0.1 (self-hosted; +https://github.com/)

# --- Jobs planifiés --------------------------------------------------------
ENABLE_JOBS=true
# Fuseau de référence : regroupement par jour des statistiques et heure
# d'exécution des tâches planifiées.
TIMEZONE=Europe/Paris

# --- Notifications poussées ------------------------------------------------
# Sans ces clés, l'application fonctionne mais les notifications restent
# visibles uniquement dans l'application. Générer la paire une fois avec :
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@exemple.fr

# --- Déploiement (docker compose) -----------------------------------------
# Domaine servi par Caddy. « :80 » en local, « scanlib.mondomaine.fr » en
# production — dans ce cas le certificat HTTPS est obtenu automatiquement.
DOMAIN=:80
# URL publique complète, utilisée pour l'origine autorisée de l'API.
PUBLIC_URL=http://localhost

# --- Front (build-time, préfixe VITE_) ------------------------------------
VITE_API_URL=http://localhost:3001
